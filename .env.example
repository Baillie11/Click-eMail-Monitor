NODE_ENV=development
PORT=3100
HOST=127.0.0.1
APP_ORIGIN=http://localhost:3100
DATABASE_URL=mysql://cmm:CHANGE_ME@127.0.0.1:3306/clickemailmonitor
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CREDENTIAL_KEY=REPLACE_WITH_64_HEX_CHARACTERS
DEMO_MODE=false
SIGNUP_LIMIT=100
MAILBOX_LIMIT=10
MIN_POLL_SECONDS=900
WORKER_BATCH_SIZE=10
# VentraIP requires cron intervals of at least 15 minutes.
# For OrangeHost-hosted cron use at least 1200, subject to your plan's confirmation.
# Alternatively use the cPanel local mail transport (no SMTP password needed).
ACCOUNT_SENDMAIL=false
ACCOUNT_SMTP_URL=smtps://USERNAME:PASSWORD@YOUR_ACCOUNT_MAIL_HOST:465
ACCOUNT_FROM=ClickeMailMonitor <accounts@YOUR_DOMAIN>
# Optional OpenAI-compatible chat-completions provider; all values must be configured.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# Set only to the known number of trusted reverse proxies; do not use a blanket true.
TRUST_PROXY_HOPS=0
