{
  "name": "clickemailmonitor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch server/main.ts",
    "start": "node dist/server/main.js",
    "worker": "tsx server/worker-main.ts",
    "worker:prod": "node dist/server/worker-main.js",
    "migrate": "tsx server/migrate.ts",
    "demo": "tsx server/demo.ts",
    "build": "tsc -p tsconfig.server.json && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "format": "prettier --write server web tests *.json *.ts *.js *.cjs",
    "worker:once": "node dist/server/worker-main.js --once",
    "migrate:prod": "node dist/server/migrate.js"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  },
  "dependencies": {
    "@electric-sql/pglite": "latest",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@node-rs/argon2": "^2.0.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.1",
    "helmet": "^8.1.0",
    "imapflow": "latest",
    "ipaddr.js": "^2.2.0",
    "lucide-react": "latest",
    "mailparser": "latest",
    "mysql2": "^3.24.6",
    "nodemailer": "latest",
    "pg": "^8.16.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "sanitize-html": "^2.18.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/mailparser": "latest",
    "@types/node": "^22.18.0",
    "@types/nodemailer": "latest",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/sanitize-html": "^2.16.0",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.34.0",
    "node": "^22.23.4",
    "prettier": "^3.9.10",
    "supertest": "^7.1.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "vite": "^6.3.5",
    "vitest": "^4.1.12"
  }
}
